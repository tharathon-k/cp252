
<!DOCTYPE html>
<html>
<head>
  <title>Inventory Tracker</title>
  <%- include('../partials/head') %>

  <style>
    .inventory-container {
      max-width: 900px;
      width: 100%;
      margin: 2rem auto;
      padding: 1.5rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--standard-border-radius);
      background: var(--bg);
    }

    /* Header */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: var(--border-width) solid var(--border);
    }

    .top-bar h1 {
      margin: 0;
      font-size: 2rem;
    }

    /* Actions */
    .action-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .action-btn {
      display: inline-block;
      padding: 0.5rem 1rem;
      border: var(--border-width) solid var(--accent);
      border-radius: var(--standard-border-radius);
      background-color: var(--accent);
      color: var(--accent-text);
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      line-height: normal;
      transition: background-color 0.2s ease;
    }

    .action-btn:visited {
      color: var(--accent-text);
    }

    .action-btn:hover {
      background-color: var(--accent-hover);
      border-color: var(--accent-hover);
      color: var(--accent-text);
    }

    .action-btn:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    /* Inventory table */
    
/* Inventory table wrapper */
figure {
  overflow-x: auto;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--bg);
}

/* Table */
.inventory-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  text-align: left;
  margin: 0;
}

/* Table cells */
.inventory-table th,
.inventory-table td {
  padding: 1rem 1.25rem;
  border: none;
  border-bottom: 1px solid var(--accent-bg);
}

/* Table header */
.inventory-table th {
  background: var(--accent-bg);
  color: var(--text-light);
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

/* Softer alternating rows */
.inventory-table tbody tr:nth-child(even) {
  background: color-mix(in srgb, var(--accent-bg) 45%, var(--bg));
}

/* Gentle hover effect */
.inventory-table tbody tr {
  transition: background-color 0.2s ease;
}

.inventory-table tbody tr:hover {
  background: var(--accent-bg);
}

/* Remove bottom border from last row */
.inventory-table tbody tr:last-child td {
  border-bottom: none;
}

/* Item links */
.item-link {
  color: var(--accent);
  font-weight: 600;
  text-decoration: none;
  transition: color 0.2s ease;
}

.item-link:hover {
  color: var(--accent-hover);
  text-decoration: underline;
}

/* Category text */
.inventory-table td:nth-child(2) {
  color: var(--text-light);
}

/* Comment count */
.comment-count {
  display: inline-block;
  min-width: 28px;
  padding: 0.2rem 0.55rem;
  border-radius: 20px;
  background: var(--accent-bg);
  color: var(--text-light);
  font-size: 0.85rem;
  text-align: center;
  font-weight: 500;
}

/* Right alignment */
.inventory-table td.text-right,
.inventory-table th.text-right {
  text-align: right;
}

/* Mobile */
@media (max-width: 720px) {
  .inventory-table th,
  .inventory-table td {
    padding: 0.8rem 0.65rem;
    font-size: 0.85rem;
  }

  .inventory-table th {
    font-size: 0.7rem;
  }
}

    /* Item links */
    .item-link {
      color: var(--accent);
      font-weight: 600;
      text-decoration: none;
    }

    .item-link:hover {
      color: var(--accent-hover);
      text-decoration: underline;
    }

    /* Comment count */
    .comment-count {
      color: var(--text-light);
      font-size: 0.9rem;
    }

    /* Empty state */
    .empty-state {
      padding: 3rem 1rem;
      text-align: center;
      color: var(--text-light);
      font-style: italic;
      background-color: var(--accent-bg);
      border: var(--border-width) dashed var(--border);
      border-radius: var(--standard-border-radius);
    }

    .empty-state p {
      margin: 0;
    }

    /* Responsive layout */
    @media (max-width: 720px) {
      .inventory-container {
        padding: 1rem;
        margin: 1rem auto;
      }

      .top-bar {
        align-items: flex-start;
        flex-direction: column;
        margin-bottom: 1.5rem;
      }

      .top-bar h1 {
        font-size: 1.75rem;
      }

      .action-group {
        width: 100%;
      }

      .action-btn {
        flex: 1;
        text-align: center;
      }

      .inventory-table th,
      .inventory-table td {
        padding: 0.65rem 0.5rem;
        font-size: 0.9rem;
      }
    }
  </style>
</head>

<body>
  <div class="inventory-container">

    <header class="top-bar">
      <h1>Inventory Items</h1>

      <div class="action-group">
        <a href="/items/new" class="action-btn">+ Add Item</a>
        <a href="/categories/new" class="action-btn">+ Add Category</a>
      </div>
    </header>

    <% if (items.length === 0) { %>

      <div class="empty-state">
        <p>No items found.</p>
      </div>

    <% } else { %>

      <figure>
        <table class="inventory-table">
          <thead>
            <tr>
              <th>Item Name</th>
              <th>Category</th>
              <th class="text-right">Comments</th>
            </tr>
          </thead>

          <tbody>
            <% items.forEach(item => { %>
              <tr>
                <td>
                  <a
                    href="/items/<%= item.id %>"
                    class="item-link"
                  ><%= item.name %></a>
                </td>

                <td><%= item.category %></td>

                <td class="text-right">
                  <span class="comment-count">
                    <%= item.comments.length %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </figure>

    <% } %>

  </div>
</body>
</html>
